% -----------------------------------------------------------------------------
% H -> gamma gamma discovery-paper category model for ATLAS Open Data 13 TeV 2025
% -----------------------------------------------------------------------------
% Notes:
%  * This is a discovery-paper-inspired TRExFitter config for 13 TeV ATLAS Open Data.
%  * The 2012 ATLAS H->gamma gamma paper used 10 categories: 2-jet plus
%    conversion/eta/pTt categories. Here converted and unconverted photon
%    categories are merged, because this config does not use a conversion flag.
%  * Resulting merged categories:
%      - 2-jet VBF-enhanced
%      - central low/high pTt
%      - rest low/high pTt
%      - transition
%  * The paper's pTt split is at 60 GeV. The transition category is not split in pTt,
%    matching the original converted-transition treatment as closely as possible.
%  * m_yy is fitted in 100--160 GeV with 2 GeV bins.
%  * The real paper used unbinned analytic data-driven background fits. TRExFitter
%    is used here with a binned prompt diphoton continuum template and free
%    per-category background normalizations as a stable approximation.

% --------------- %
% ---  JOB    --- %
% --------------- %

Job: "hyy"
  Label: "H#rightarrow#gamma#gamma discovery-inspired merged categories"
  CmeLabel: "13 TeV"
  POI: "mu_H"
  ReadFrom: NTUP
  NtuplePaths: "/workdir/inputs/"
  NtupleName: "analysis"
  LumiLabel: "36.1 fb^{-1}"
  Lumi: 36100
  DebugLevel: 1
  PlotOptions: "NOXERR"
  SplitHistoFiles: TRUE
  SystControlPlots: TRUE
  SystCategoryTables: TRUE
  CorrelationThreshold: 0.2
  MCstatThreshold: 0.01

% --------------- %
% ---  FIT    --- %
% --------------- %

Fit: "fit"
  FitType: SPLUSB
  FitRegion: CRSR
  POIAsimov: 1
%  UseMinos: mu_H

% ------------------------ %
% --- USEFUL EXPRESSIONS -- %
% ------------------------ %
% m_yy = sqrt(2*photon_pt[0]*photon_pt[1]*(cosh(photon_eta[0]-photon_eta[1]) - cos(photon_phi[0]-photon_phi[1])))
% pTt  = fabs(2*photon_pt[0]*photon_pt[1]*sin(photon_phi[0]-photon_phi[1]))/sqrt(pow(photon_pt[0],2)+pow(photon_pt[1],2)-2*photon_pt[0]*photon_pt[1]*cos(photon_phi[0]-photon_phi[1]))
% m_jj = sqrt(2*jet_pt[0]*jet_pt[1]*(cosh(jet_eta[0]-jet_eta[1])-cos(jet_phi[0]-jet_phi[1])))
% dphi(gamgam,jj) = acos(cos((atan2(photon_pt[0]*sin(photon_phi[0])+photon_pt[1]*sin(photon_phi[1]),photon_pt[0]*cos(photon_phi[0])+photon_pt[1]*cos(photon_phi[1])))-(atan2(jet_pt[0]*sin(jet_phi[0])+jet_pt[1]*sin(jet_phi[1]),jet_pt[0]*cos(jet_phi[0])+jet_pt[1]*cos(jet_phi[1])))))

% --------------- %
% --- REGIONS --- %
% --------------- %

Region: "cat_2jet"
  Type: SIGNAL
  Variable: "sqrt(2*photon_pt[0]*photon_pt[1]*(cosh(photon_eta[0]-photon_eta[1]) - cos(photon_phi[0]-photon_phi[1])))",15,100,160
  VariableTitle: "m_{#gamma#gamma} [GeV]"
  Selection: "(photon_n>=2 && trigP && photon_pt[0]>40 && photon_pt[1]>30 && fabs(photon_eta[0])<2.37 && fabs(photon_eta[1])<2.37 && !(fabs(photon_eta[0])>=1.37 && fabs(photon_eta[0])<1.52) && !(fabs(photon_eta[1])>=1.37 && fabs(photon_eta[1])<1.52)) && (jet_n>=2 && jet_pt[0]>25 && jet_pt[1]>25 && fabs(jet_eta[0])<4.5 && fabs(jet_eta[1])<4.5 && fabs(jet_eta[0]-jet_eta[1])>2.8 && (sqrt(2*jet_pt[0]*jet_pt[1]*(cosh(jet_eta[0]-jet_eta[1])-cos(jet_phi[0]-jet_phi[1]))))>400 && (acos(cos((atan2(photon_pt[0]*sin(photon_phi[0])+photon_pt[1]*sin(photon_phi[1]),photon_pt[0]*cos(photon_phi[0])+photon_pt[1]*cos(photon_phi[1])))-(atan2(jet_pt[0]*sin(jet_phi[0])+jet_pt[1]*sin(jet_phi[1]),jet_pt[0]*cos(jet_phi[0])+jet_pt[1]*cos(jet_phi[1]))))))>2.6)"
  Label: "2-jet VBF-enhanced"
  ShortLabel: "cat_2jet"

Region: "cat_central_lowptt"
  Type: SIGNAL
  Variable: "sqrt(2*photon_pt[0]*photon_pt[1]*(cosh(photon_eta[0]-photon_eta[1]) - cos(photon_phi[0]-photon_phi[1])))",15,100,160
  VariableTitle: "m_{#gamma#gamma} [GeV]"
  Selection: "(photon_n>=2 && trigP && photon_pt[0]>40 && photon_pt[1]>30 && fabs(photon_eta[0])<2.37 && fabs(photon_eta[1])<2.37 && !(fabs(photon_eta[0])>=1.37 && fabs(photon_eta[0])<1.52) && !(fabs(photon_eta[1])>=1.37 && fabs(photon_eta[1])<1.52)) && !(jet_n>=2 && jet_pt[0]>25 && jet_pt[1]>25 && fabs(jet_eta[0])<4.5 && fabs(jet_eta[1])<4.5 && fabs(jet_eta[0]-jet_eta[1])>2.8 && (sqrt(2*jet_pt[0]*jet_pt[1]*(cosh(jet_eta[0]-jet_eta[1])-cos(jet_phi[0]-jet_phi[1]))))>400 && (acos(cos((atan2(photon_pt[0]*sin(photon_phi[0])+photon_pt[1]*sin(photon_phi[1]),photon_pt[0]*cos(photon_phi[0])+photon_pt[1]*cos(photon_phi[1])))-(atan2(jet_pt[0]*sin(jet_phi[0])+jet_pt[1]*sin(jet_phi[1]),jet_pt[0]*cos(jet_phi[0])+jet_pt[1]*cos(jet_phi[1]))))))>2.6) && (fabs(photon_eta[0])<0.75 && fabs(photon_eta[1])<0.75) && ((fabs(2*photon_pt[0]*photon_pt[1]*sin(photon_phi[0]-photon_phi[1]))/sqrt(pow(photon_pt[0],2)+pow(photon_pt[1],2)-2*photon_pt[0]*photon_pt[1]*cos(photon_phi[0]-photon_phi[1])))<=60)"
  Label: "central photons, low p_{Tt}"
  ShortLabel: "cat_central_lowptt"

Region: "cat_central_highptt"
  Type: SIGNAL
  Variable: "sqrt(2*photon_pt[0]*photon_pt[1]*(cosh(photon_eta[0]-photon_eta[1]) - cos(photon_phi[0]-photon_phi[1])))",15,100,160
  VariableTitle: "m_{#gamma#gamma} [GeV]"
  Selection: "(photon_n>=2 && trigP && photon_pt[0]>40 && photon_pt[1]>30 && fabs(photon_eta[0])<2.37 && fabs(photon_eta[1])<2.37 && !(fabs(photon_eta[0])>=1.37 && fabs(photon_eta[0])<1.52) && !(fabs(photon_eta[1])>=1.37 && fabs(photon_eta[1])<1.52)) && !(jet_n>=2 && jet_pt[0]>25 && jet_pt[1]>25 && fabs(jet_eta[0])<4.5 && fabs(jet_eta[1])<4.5 && fabs(jet_eta[0]-jet_eta[1])>2.8 && (sqrt(2*jet_pt[0]*jet_pt[1]*(cosh(jet_eta[0]-jet_eta[1])-cos(jet_phi[0]-jet_phi[1]))))>400 && (acos(cos((atan2(photon_pt[0]*sin(photon_phi[0])+photon_pt[1]*sin(photon_phi[1]),photon_pt[0]*cos(photon_phi[0])+photon_pt[1]*cos(photon_phi[1])))-(atan2(jet_pt[0]*sin(jet_phi[0])+jet_pt[1]*sin(jet_phi[1]),jet_pt[0]*cos(jet_phi[0])+jet_pt[1]*cos(jet_phi[1]))))))>2.6) && (fabs(photon_eta[0])<0.75 && fabs(photon_eta[1])<0.75) && ((fabs(2*photon_pt[0]*photon_pt[1]*sin(photon_phi[0]-photon_phi[1]))/sqrt(pow(photon_pt[0],2)+pow(photon_pt[1],2)-2*photon_pt[0]*photon_pt[1]*cos(photon_phi[0]-photon_phi[1])))>60)"
  Label: "central photons, high p_{Tt}"
  ShortLabel: "cat_central_highptt"

Region: "cat_rest_lowptt"
  Type: SIGNAL
  Variable: "sqrt(2*photon_pt[0]*photon_pt[1]*(cosh(photon_eta[0]-photon_eta[1]) - cos(photon_phi[0]-photon_phi[1])))",15,100,160
  VariableTitle: "m_{#gamma#gamma} [GeV]"
  Selection: "(photon_n>=2 && trigP && photon_pt[0]>40 && photon_pt[1]>30 && fabs(photon_eta[0])<2.37 && fabs(photon_eta[1])<2.37 && !(fabs(photon_eta[0])>=1.37 && fabs(photon_eta[0])<1.52) && !(fabs(photon_eta[1])>=1.37 && fabs(photon_eta[1])<1.52)) && !(jet_n>=2 && jet_pt[0]>25 && jet_pt[1]>25 && fabs(jet_eta[0])<4.5 && fabs(jet_eta[1])<4.5 && fabs(jet_eta[0]-jet_eta[1])>2.8 && (sqrt(2*jet_pt[0]*jet_pt[1]*(cosh(jet_eta[0]-jet_eta[1])-cos(jet_phi[0]-jet_phi[1]))))>400 && (acos(cos((atan2(photon_pt[0]*sin(photon_phi[0])+photon_pt[1]*sin(photon_phi[1]),photon_pt[0]*cos(photon_phi[0])+photon_pt[1]*cos(photon_phi[1])))-(atan2(jet_pt[0]*sin(jet_phi[0])+jet_pt[1]*sin(jet_phi[1]),jet_pt[0]*cos(jet_phi[0])+jet_pt[1]*cos(jet_phi[1]))))))>2.6) && (!(fabs(photon_eta[0])<0.75 && fabs(photon_eta[1])<0.75) && !((fabs(photon_eta[0])>1.3 && fabs(photon_eta[0])<1.75) || (fabs(photon_eta[1])>1.3 && fabs(photon_eta[1])<1.75))) && ((fabs(2*photon_pt[0]*photon_pt[1]*sin(photon_phi[0]-photon_phi[1]))/sqrt(pow(photon_pt[0],2)+pow(photon_pt[1],2)-2*photon_pt[0]*photon_pt[1]*cos(photon_phi[0]-photon_phi[1])))<=60)"
  Label: "rest photons, low p_{Tt}"
  ShortLabel: "cat_rest_lowptt"

Region: "cat_rest_highptt"
  Type: SIGNAL
  Variable: "sqrt(2*photon_pt[0]*photon_pt[1]*(cosh(photon_eta[0]-photon_eta[1]) - cos(photon_phi[0]-photon_phi[1])))",15,100,160
  VariableTitle: "m_{#gamma#gamma} [GeV]"
  Selection: "(photon_n>=2 && trigP && photon_pt[0]>40 && photon_pt[1]>30 && fabs(photon_eta[0])<2.37 && fabs(photon_eta[1])<2.37 && !(fabs(photon_eta[0])>=1.37 && fabs(photon_eta[0])<1.52) && !(fabs(photon_eta[1])>=1.37 && fabs(photon_eta[1])<1.52)) && !(jet_n>=2 && jet_pt[0]>25 && jet_pt[1]>25 && fabs(jet_eta[0])<4.5 && fabs(jet_eta[1])<4.5 && fabs(jet_eta[0]-jet_eta[1])>2.8 && (sqrt(2*jet_pt[0]*jet_pt[1]*(cosh(jet_eta[0]-jet_eta[1])-cos(jet_phi[0]-jet_phi[1]))))>400 && (acos(cos((atan2(photon_pt[0]*sin(photon_phi[0])+photon_pt[1]*sin(photon_phi[1]),photon_pt[0]*cos(photon_phi[0])+photon_pt[1]*cos(photon_phi[1])))-(atan2(jet_pt[0]*sin(jet_phi[0])+jet_pt[1]*sin(jet_phi[1]),jet_pt[0]*cos(jet_phi[0])+jet_pt[1]*cos(jet_phi[1]))))))>2.6) && (!(fabs(photon_eta[0])<0.75 && fabs(photon_eta[1])<0.75) && !((fabs(photon_eta[0])>1.3 && fabs(photon_eta[0])<1.75) || (fabs(photon_eta[1])>1.3 && fabs(photon_eta[1])<1.75))) && ((fabs(2*photon_pt[0]*photon_pt[1]*sin(photon_phi[0]-photon_phi[1]))/sqrt(pow(photon_pt[0],2)+pow(photon_pt[1],2)-2*photon_pt[0]*photon_pt[1]*cos(photon_phi[0]-photon_phi[1])))>60)"
  Label: "rest photons, high p_{Tt}"
  ShortLabel: "cat_rest_highptt"

Region: "cat_transition"
  Type: SIGNAL
  Variable: "sqrt(2*photon_pt[0]*photon_pt[1]*(cosh(photon_eta[0]-photon_eta[1]) - cos(photon_phi[0]-photon_phi[1])))",15,100,160
  VariableTitle: "m_{#gamma#gamma} [GeV]"
  Selection: "(photon_n>=2 && trigP && photon_pt[0]>40 && photon_pt[1]>30 && fabs(photon_eta[0])<2.37 && fabs(photon_eta[1])<2.37 && !(fabs(photon_eta[0])>=1.37 && fabs(photon_eta[0])<1.52) && !(fabs(photon_eta[1])>=1.37 && fabs(photon_eta[1])<1.52)) && !(jet_n>=2 && jet_pt[0]>25 && jet_pt[1]>25 && fabs(jet_eta[0])<4.5 && fabs(jet_eta[1])<4.5 && fabs(jet_eta[0]-jet_eta[1])>2.8 && (sqrt(2*jet_pt[0]*jet_pt[1]*(cosh(jet_eta[0]-jet_eta[1])-cos(jet_phi[0]-jet_phi[1]))))>400 && (acos(cos((atan2(photon_pt[0]*sin(photon_phi[0])+photon_pt[1]*sin(photon_phi[1]),photon_pt[0]*cos(photon_phi[0])+photon_pt[1]*cos(photon_phi[1])))-(atan2(jet_pt[0]*sin(jet_phi[0])+jet_pt[1]*sin(jet_phi[1]),jet_pt[0]*cos(jet_phi[0])+jet_pt[1]*cos(jet_phi[1]))))))>2.6) && ((fabs(photon_eta[0])>1.3 && fabs(photon_eta[0])<1.75) || (fabs(photon_eta[1])>1.3 && fabs(photon_eta[1])<1.75))"
  Label: "transition photons"
  ShortLabel: "cat_transition"

% --------------- %
% --- SAMPLES --- %
% --------------- %

Sample: "Data"
  Type: DATA
  NtuplePathSuff: "Data"
  NtupleFiles: "ODEO_FEB2025_v0_GamGam_data15_period*.GamGam","ODEO_FEB2025_v0_GamGam_data16_period*.GamGam"
  Selection: "photon_isTightID[0] && photon_isTightID[1] && photon_isTightIso[0] && photon_isTightIso[1]"

Sample: "diphoton"
  Type: BACKGROUND
  Title: "#gamma#gamma continuum"
  FillColor: 616
  LineColor: 1
  NtuplePathSuff: "MC"
  NtupleFiles: "ODEO_FEB2025_v0_GamGam_mc_364350.Sherpa_224_NNPDF30NNLO_Diphoton_myy_0_50.GamGam","ODEO_FEB2025_v0_GamGam_mc_364351.Sherpa_224_NNPDF30NNLO_Diphoton_myy_50_90.GamGam","ODEO_FEB2025_v0_GamGam_mc_364352.Sherpa_224_NNPDF30NNLO_Diphoton_myy_90_175.GamGam","ODEO_FEB2025_v0_GamGam_mc_364353.Sherpa_224_NNPDF30NNLO_Diphoton_myy_175_2000.GamGam"
  MCweight: "mcWeight * xsec * filteff * kfac * ScaleFactor_PILEUP * ScaleFactor_PHOTON / sum_of_weights"
  Selection: "photon_isTightID[0] && photon_isTightID[1] && photon_isTightIso[0] && photon_isTightIso[1]"
  UseMCstat: FALSE

Sample: "ggH"
  Type: SIGNAL
  Title: "ggH, H#rightarrow#gamma#gamma"
  FillColor: 2
  LineColor: 2
  NtuplePathSuff: "MC"
  NtupleFiles: "ODEO_FEB2025_v0_GamGam_mc_343981.PowhegPythia8EvtGen_NNLOPS_nnlo_30_ggH125_gamgam.GamGam"
  MCweight: "mcWeight * xsec * filteff * kfac * ScaleFactor_PILEUP * ScaleFactor_PHOTON / sum_of_weights"
  Selection: "photon_isTightID[0] && photon_isTightID[1] && photon_isTightIso[0] && photon_isTightIso[1]"
  UseMCstat: FALSE

Sample: "VBFH"
  Type: SIGNAL
  Title: "VBF H, H#rightarrow#gamma#gamma"
  FillColor: 4
  LineColor: 4
  NtuplePathSuff: "MC"
  NtupleFiles: "ODEO_FEB2025_v0_GamGam_mc_346214.PowhegPy8EG_NNPDF30_AZNLOCTEQ6L1_VBFH125_gamgam.GamGam"
  MCweight: "mcWeight * xsec * filteff * kfac * ScaleFactor_PILEUP * ScaleFactor_PHOTON / sum_of_weights"
  Selection: "photon_isTightID[0] && photon_isTightID[1] && photon_isTightIso[0] && photon_isTightIso[1]"
  UseMCstat: FALSE

Sample: "WH"
  Type: SIGNAL
  Title: "WH, H#rightarrow#gamma#gamma"
  FillColor: 8
  LineColor: 8
  NtuplePathSuff: "MC"
  NtupleFiles: "ODEO_FEB2025_v0_GamGam_mc_345317.PowhegPythia8EvtGen_NNPDF30_AZNLO_WmH125J_Hyy_Wincl_MINLO.GamGam","ODEO_FEB2025_v0_GamGam_mc_345318.PowhegPythia8EvtGen_NNPDF30_AZNLO_WpH125J_Hyy_Wincl_MINLO.GamGam"
  MCweight: "mcWeight * xsec * filteff * kfac * ScaleFactor_PILEUP * ScaleFactor_PHOTON / sum_of_weights"
  Selection: "photon_isTightID[0] && photon_isTightID[1] && photon_isTightIso[0] && photon_isTightIso[1]"
  UseMCstat: FALSE

Sample: "ZH"
  Type: SIGNAL
  Title: "ZH, H#rightarrow#gamma#gamma"
  FillColor: 9
  LineColor: 9
  NtuplePathSuff: "MC"
  NtupleFiles: "ODEO_FEB2025_v0_GamGam_mc_345319.PowhegPythia8EvtGen_NNPDF30_AZNLO_ZH125J_Hyy_Zincl_MINLO.GamGam"
  MCweight: "mcWeight * xsec * filteff * kfac * ScaleFactor_PILEUP * ScaleFactor_PHOTON / sum_of_weights"
  Selection: "photon_isTightID[0] && photon_isTightID[1] && photon_isTightIso[0] && photon_isTightIso[1]"
  UseMCstat: FALSE

Sample: "ttH"
  Type: SIGNAL
  Title: "ttH, H#rightarrow#gamma#gamma"
  FillColor: 3
  LineColor: 3
  NtuplePathSuff: "MC"
  NtupleFiles: "ODEO_FEB2025_v0_GamGam_mc_346525.PowhegPythia8EvtGen_A14NNPDF23_NNPDF30ME_ttH125_gamgam.GamGam"
  MCweight: "mcWeight * xsec * filteff * kfac * ScaleFactor_PILEUP * ScaleFactor_PHOTON / sum_of_weights"
  Selection: "photon_isTightID[0] && photon_isTightID[1] && photon_isTightIso[0] && photon_isTightIso[1]"
  UseMCstat: FALSE

% -------------------- %
% --- NORM FACTORS --- %
% -------------------- %

NormFactor: "mu_H"
  Samples: ggH,VBFH,WH,ZH,ttH
  Title: "#mu_{H}"
  Nominal: 1
  Min: 0
  Max: 50

NormFactor: "mu_yy_cat_2jet"
  Samples: diphoton
  Regions: cat_2jet
  Title: "#mu_{#gamma#gamma,2j}"
  Nominal: 1
  Min: 0
  Max: 10

NormFactor: "mu_yy_cat_central_lowptt"
  Samples: diphoton
  Regions: cat_central_lowptt
  Title: "#mu_{#gamma#gamma,central low pTt}"
  Nominal: 1
  Min: 0
  Max: 10

NormFactor: "mu_yy_cat_central_highptt"
  Samples: diphoton
  Regions: cat_central_highptt
  Title: "#mu_{#gamma#gamma,central high pTt}"
  Nominal: 1
  Min: 0
  Max: 10

NormFactor: "mu_yy_cat_rest_lowptt"
  Samples: diphoton
  Regions: cat_rest_lowptt
  Title: "#mu_{#gamma#gamma,rest low pTt}"
  Nominal: 1
  Min: 0
  Max: 10

NormFactor: "mu_yy_cat_rest_highptt"
  Samples: diphoton
  Regions: cat_rest_highptt
  Title: "#mu_{#gamma#gamma,rest high pTt}"
  Nominal: 1
  Min: 0
  Max: 10

NormFactor: "mu_yy_cat_transition"
  Samples: diphoton
  Regions: cat_transition
  Title: "#mu_{#gamma#gamma,transition}"
  Nominal: 1
  Min: 0
  Max: 10
